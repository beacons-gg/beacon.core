{
  "name": "@beaconsgg/protocol-types",
  "version": "0.0.0",
  "description": "zod schemas + inferred types + JCS canonical-serialization helper (the wire contract).",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/beacons-gg/beacon.core.git",
    "directory": "packages/core/protocol-types"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./examples": {
      "types": "./dist/examples.d.ts",
      "default": "./dist/examples.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "examples": [
        "./dist/examples.d.ts"
      ],
      "server": [
        "./dist/server.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "canonicalize": "catalog:"
  },
  "devDependencies": {
    "zod": "catalog:",
    "typescript": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "vitest": "catalog:",
    "@beaconsgg/tsconfig": "workspace:*",
    "@beaconsgg/vitest-config": "workspace:*"
  },
  "peerDependencies": {
    "zod": "catalog:"
  }
}

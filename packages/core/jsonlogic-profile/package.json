{
  "name": "@beaconsgg/jsonlogic-profile",
  "version": "1.1.2",
  "description": "[C] client-bound (RN-safe): whitelisted JSONLogic profile + 4 aggregators + integer guard + conformance vectors.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/beacons-gg/beacon.core.git",
    "directory": "packages/core/jsonlogic-profile"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "@beaconsgg/protocol-types": "workspace:*",
    "json-logic-js": "catalog:"
  },
  "devDependencies": {
    "@types/json-logic-js": "catalog:",
    "typescript": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "vitest": "catalog:",
    "@beaconsgg/tsconfig": "workspace:*",
    "@beaconsgg/vitest-config": "workspace:*"
  }
}

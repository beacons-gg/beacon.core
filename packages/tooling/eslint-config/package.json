{
  "name": "@beaconsgg/eslint-config",
  "version": "0.0.0",
  "description": "The ESLint config every Beacon repo lints with: the base rules, the RN-safety gate, the tier gate, the check that a game app's own config carries its gate, the check for references a public reader cannot open, and the writing style guide with its check.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/beacons-gg/beacon.core.git",
    "directory": "packages/tooling/eslint-config"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./copy": {
      "types": "./scripts/copy.d.mts",
      "default": "./scripts/copy.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "beacon-check-copy": "./scripts/check-copy.mjs",
    "beacon-check-internal-refs": "./scripts/check-internal-refs.mjs",
    "beacon-check-tier-gate": "./scripts/check-tier-gate.mjs"
  },
  "files": [
    "src",
    "!src/__tests__",
    "scripts",
    "STYLE.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "@eslint/js": "catalog:",
    "eslint-config-prettier": "catalog:",
    "typescript-eslint": "catalog:",
    "yaml": "catalog:"
  },
  "peerDependencies": {
    "eslint": "catalog:",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@beaconsgg/vitest-config": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

{
  "name": "@beaconsgg/vitest-config",
  "version": "1.1.2",
  "description": "The vitest config every Beacon workspace tests with: the coverage scope, the line floor, and the check that every suite holds one.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/beacons-gg/beacon.core.git",
    "directory": "packages/tooling/vitest-config"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "beacon-check-coverage-tasks": "./scripts/check-coverage-tasks.mjs"
  },
  "files": [
    "dist",
    "scripts",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "peerDependencies": {
    "@vitest/coverage-v8": "catalog:",
    "vitest": "catalog:"
  },
  "devDependencies": {
    "@beaconsgg/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
